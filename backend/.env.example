DATABASE_URL=postgresql+psycopg2://meysam@localhost:5432/didar
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,https://didar.cls9.com
# true = seed demo users with shared password didar123
# false = no auto-seed; invites get one-time random passwords
DEMO_SEED=true
DEMO_PASSWORD=didar123
JWT_SECRET=change-me-in-production
# IRT display units → IRR ledger units
IRT_TO_IRR=10
# Zarrin adapter: test = local shaped responses; live = HTTP when URL+key set
ZARRIN_MODE=test
ZARRIN_BASE_URL=
ZARRIN_API_KEY=
# Allow /admin/reseed when DEMO_SEED=false (keep false in production)
ALLOW_DESTRUCTIVE_ADMIN=false
