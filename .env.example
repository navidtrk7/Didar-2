# Copy to .env.local
#
# Production builds REQUIRE an API URL (offline mock is disabled).
# Local demo without backend: leave empty AND run `next dev` (not production).
#
# Recommended (phone/LAN safe): same-origin proxy via next.config rewrites
NEXT_PUBLIC_API_URL=/didar-api
#
# Or point straight at the API
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
#
# Force API even in next dev (optional)
# NEXT_PUBLIC_REQUIRE_API=true
